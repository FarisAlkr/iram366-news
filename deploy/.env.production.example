# ============================================================
# IRAM 366 News — Production Environment Variables
# Copy this to /opt/iram366/.env on the VPS and fill in values
# ============================================================

# Database (internal Docker network — don't change host/port)
POSTGRES_USER=iram366
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=iram366
DATABASE_URL=postgresql://iram366:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/iram366

# Payload CMS
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Preview mode secret (used by admin Live Preview + "Preview" button)
# Generate with: openssl rand -hex 32
PAYLOAD_PREVIEW_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Cloudflare R2 Storage
R2_BUCKET=iram366-media
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Site URL (your actual domain with https)
NEXT_PUBLIC_SITE_URL=https://iram366.com

# Domain for Caddy auto-HTTPS (no https:// prefix)
DOMAIN=iram366.com

# Seed admin password (only needed for initial seed)
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
