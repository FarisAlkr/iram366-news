# ============================================================================
# IRAM 366 News — Environment Configuration
# Copy to `.env` and fill in. NEVER commit `.env` itself.
# Generate strong secrets with: openssl rand -hex 32
# ============================================================================

# --- Database ---------------------------------------------------------------
# In docker-compose, host is `db`. For local dev outside docker, use localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iram366
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iram366

# --- Payload ----------------------------------------------------------------
# Used for cookie signing + secret keys; rotating it logs everyone out.
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
# Token shared with /preview/articles/[slug]?secret=… — keep private.
PAYLOAD_PREVIEW_SECRET=replace-with-openssl-rand-hex-32

# --- Cloudflare R2 (S3-compatible storage) ----------------------------------
R2_BUCKET=iram366-media
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_PUBLIC_URL=https://your-bucket.r2.dev

# --- Site -------------------------------------------------------------------
# REQUIRED in production. Used to build absolute URLs for sitemap.xml, RSS,
# OG/Twitter cards, JSON-LD, and canonical links. If unset, every absolute
# URL the site emits falls back to http://localhost:3000 — Google indexes
# the wrong host, social previews break, RSS readers get bad links.
# Must be inlined at BUILD time too (see Dockerfile ARG/ENV for it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DOMAIN=iram366.com
ACME_EMAIL=iramnews366@gmail.com

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Service name attached to every structured log line — handy when logs from
# multiple services land in the same drain.
LOG_SERVICE=iram366-news

# --- SMTP -------------------------------------------------------------------
# DEFERRED — not wired in code as of 2026-05-14. Setting these does nothing
# until the Payload email adapter is configured. See
# docs/post-launch-backlog.md → "SMTP / password reset" for the plan.
# Until then, Payload writes password-reset mails to the server log only
# and the /admin login UI shows a friendly Arabic "feature in development"
# message instead of pretending to send the email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=إرم 366 الإخبارية
SMTP_FROM_ADDRESS=iramnews366@gmail.com

# --- Cloudflare Analytics ---------------------------------------------------
# Public site beacon token — visible in client HTML by design. Loaded as
# `defer` from static.cloudflareinsights.com in (frontend)/layout.tsx.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# Server-side credentials for pulling analytics back into the admin
# dashboard. Distinct from the beacon token above.
CF_ACCOUNT_ID=
CF_ANALYTICS_API_TOKEN=

# --- Chatbot (semantic article search) --------------------------------------
# Build-time kill switch. `false` strips the widget entirely; any other value
# (including unset) is treated as enabled and lets the runtime decide.
NEXT_PUBLIC_CHATBOT_ENABLED=true
# Which embedding provider to call. `openai` uses OPENAI_API_KEY,
# `voyage` uses VOYAGE_API_KEY. Pick one and supply the matching key.
EMBEDDINGS_PROVIDER=openai
# Override the default model for the chosen provider. Optional.
EMBEDDINGS_MODEL=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Accessibility (UserWay free tier, Israeli Regulation 35) ---------------
# Account ID from the UserWay dashboard (free tier; ~5 min signup at
# userway.org). When set, the widget loads with data-position=8 — docked to
# the footer, NOT floating, because the bottom-left and bottom-right are
# already occupied by the social-hub and chatbot toggles. Leave blank in
# dev — the in-footer "נגישות · إمكانية الوصول" button still works as a
# link to /accessibility-statement when the widget is absent.
NEXT_PUBLIC_USERWAY_ACCOUNT_ID=

# --- Error monitoring (Sentry) ----------------------------------------------
# Free Sentry account (5K events/month) — see docs/sentry-setup.md for the
# step-by-step. Leave blank during local dev; in production an unset DSN
# turns Sentry into a no-op (no errors get captured but the app still runs).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Signature UI -----------------------------------------------------------
# Build-time kill switches for the decorative effects. Set to `false` to
# strip them at the build level (the components don't mount at all).
# Per-environment runtime control is in /admin → site-settings → "لمسات بصرية".
NEXT_PUBLIC_FEATURE_CURSOR_INK=true
NEXT_PUBLIC_FEATURE_FOOTER_CAMEL=true
# Floating social-hub button (bottom-left in RTL). Same enable semantics as
# the two effects above.
NEXT_PUBLIC_FEATURE_SOCIAL_HUB=true

# --- Seeding ----------------------------------------------------------------
# Initial admin password for `npm run seed` (the CLI seed). Rotate after first login.
ADMIN_PASSWORD=changeme
# Required by the /api/seed endpoint to allow re-seeding sample data.
# Disabled in production unless ALLOW_SEED_IN_PRODUCTION=1 is also set.
SEED_SECRET=
ALLOW_SEED_IN_PRODUCTION=0
