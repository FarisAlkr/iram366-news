# ============================================================================
# IRAM 366 News — Environment Configuration
# Copy to `.env` and fill in. NEVER commit `.env` itself.
# Generate strong secrets with: openssl rand -hex 32
# ============================================================================

# --- Database ---------------------------------------------------------------
# In docker-compose, host is `db`. For local dev outside docker, use localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iram366
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iram366

# --- Payload ----------------------------------------------------------------
# Used for cookie signing + secret keys; rotating it logs everyone out.
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
# Token shared with /preview/articles/[slug]?secret=… — keep private.
PAYLOAD_PREVIEW_SECRET=replace-with-openssl-rand-hex-32

# --- Cloudflare R2 (S3-compatible storage) ----------------------------------
R2_BUCKET=iram366-media
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_PUBLIC_URL=https://your-bucket.r2.dev

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DOMAIN=iram366.com
ACME_EMAIL=iramnews366@gmail.com

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- SMTP (optional — enables password reset & notifications) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=إرم 366 الإخبارية
SMTP_FROM_ADDRESS=iramnews366@gmail.com

# --- Seeding ----------------------------------------------------------------
# Initial admin password for `npm run seed` (the CLI seed). Rotate after first login.
ADMIN_PASSWORD=changeme
# Required by the /api/seed endpoint to allow re-seeding sample data.
# Disabled in production unless ALLOW_SEED_IN_PRODUCTION=1 is also set.
SEED_SECRET=
ALLOW_SEED_IN_PRODUCTION=0
